# Contentful CMS Configuration
# Get these values from your Contentful dashboard:
# 1. Go to Settings > API keys
# 2. Create a new API key or use an existing one
# 3. Copy the Space ID and Content Delivery API access token

VITE_CONTENTFUL_SPACE_ID=your_space_id_here
VITE_CONTENTFUL_ACCESS_TOKEN=your_access_token_here
VITE_CONTENTFUL_ENVIRONMENT=master

# Optional: Preview API for draft content (for admin/editor access)
# VITE_CONTENTFUL_PREVIEW_ACCESS_TOKEN=your_preview_token_here
# VITE_CONTENTFUL_PREVIEW_MODE=false
